# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง
#
#     cp .env.example .env
#
# .env ไม่ขึ้น git ไฟล์นี้ขึ้น — **ห้ามใส่ค่าจริงลงไฟล์นี้**
# ในนี้มีแต่ของลับ ขาดตัวไหนแอปไม่ขึ้น (ตรวจใน app/core/load_env.py)
# ค่าที่ใครเห็นก็ได้ เช่น endpoint อยู่ใน app/core/config.py ไม่ต้องตั้งที่นี่


# --- Postgres ---
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LINE --- เอาจาก LINE Developers Console > Messaging API ของ OA
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Typhoon ---
TYPHOON_API_KEY=

# --- Google AI Studio --- เอาจาก aistudio.google.com > Get API key (ยังไม่ได้ใช้ ขาดได้)
GOOGLE_AI_API_KEY=
