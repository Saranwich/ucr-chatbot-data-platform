CHANNEL_SECRET=your_line_channel_secret_here
CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
DATABASE_URL=postgresql://username:password@localhost/dbname

# LIFF — Report form (/report → app/static/report_form.html)
LIFF_REPORT_ID=your_liff_report_app_id
LIFF_REPORT_URL=https://liff.line.me/your_liff_report_app_id

# LIFF — Edit profile form (/userdata → app/static/userdata_form.html)
EDIT_PROFILE_ID=your_liff_edit_profile_app_id
EDIT_PROFILE_URL=https://liff.line.me/your_liff_edit_profile_app_id

SECRET_KEY=your_jwt_secret_key_here   # required — app refuses to start without it
# ALGORITHM=HS256                     # JWT algorithm (default HS256)
# FRONTEND_URL=http://localhost:4200  # dashboard origin allowed by CORS
# ENV=production                      # set to hide /docs and /redoc