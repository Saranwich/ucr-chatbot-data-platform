# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง
#
#     cp .env.example .env
#
# .env ไม่ขึ้น git (ดู .gitignore) ไฟล์นี้ขึ้น — **ห้ามเผลอใส่ค่าจริงลงไฟล์นี้**


# --- AI ---
# endpoint ของทีม พูดภาษาเดียวกับ OpenAI เลยใช้ไลบรารีตัวนั้นต่อได้ (app/clients/llm.py)
API_KEY=
OPENAI_API_ENDPOINT=https://

# อ่านเข้ามาใน config.py แต่ยังไม่มีใครเรียกใช้ — เว้นว่างไว้ได้
ANTHROPIC_API_ENDPOINT=


# --- LINE ---
# ทั้งสองค่าเอาจาก LINE Developers Console > ช่อง Messaging API ของ OA
# secret ใช้ตรวจลายเซ็น webhook / token ใช้ยิงข้อความกลับ
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=


# --- Redis (บทสนทนาที่ยังคุยค้าง ของชั่วคราว) ---
# ไม่ตั้งก็ได้ โค้ดใช้ค่านี้เป็น default อยู่แล้ว
REDIS_URL=redis://localhost:6379/0


# --- Postgres (รายงานที่ปิดใบแล้ว ของถาวร) ---
# ต้องเป็น instance ที่เปิด PostGIS ได้ เพราะเก็บพิกัดเป็น geography(Point, 4326)
DATABASE_URL=postgresql://user:password@localhost:5432/ucr
